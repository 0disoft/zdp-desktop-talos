{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.0disoft.com/talos/update/v1/update-manifest.schema.json",
  "title": "Talos Signed Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "channel",
    "version",
    "minimum_current_version",
    "published_at",
    "expires_at",
    "target",
    "artifact"
  ],
  "properties": {
    "schema": { "const": "talos.update-manifest/1" },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "channel": { "enum": ["alpha", "beta", "stable"] },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "minimum_current_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "published_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
        "architecture": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/\\\\]+$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
