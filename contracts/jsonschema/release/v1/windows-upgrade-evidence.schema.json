{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.0disoft.dev/talos/release/v1/windows-upgrade-evidence.schema.json",
  "title": "Talos Windows Upgrade Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "architecture",
    "verifier_commit",
    "old_run_id",
    "new_run_id",
    "phases"
  ],
  "properties": {
    "schema": { "const": "talos.windows-upgrade-evidence/1" },
    "status": { "enum": ["passed", "failed"] },
    "architecture": { "const": "amd64" },
    "verifier_commit": { "$ref": "#/$defs/commit" },
    "old_run_id": { "$ref": "#/$defs/run_id" },
    "new_run_id": { "$ref": "#/$defs/run_id" },
    "old_package": { "$ref": "#/$defs/package" },
    "new_package": { "$ref": "#/$defs/package" },
    "vault": { "$ref": "#/$defs/vault" },
    "phases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/phase" }
    },
    "failure": { "$ref": "#/$defs/failure" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "required": ["old_package", "new_package", "vault"],
        "not": { "required": ["failure"] },
        "properties": { "phases": { "minItems": 9 } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["failure"] }
    }
  ],
  "$defs": {
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "receipt_sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {
          "enum": [
            "guard",
            "package-verification",
            "old-install",
            "old-vault",
            "new-install",
            "new-vault",
            "uninstall-retention",
            "rollback",
            "purge",
            "cleanup"
          ]
        },
        "status": { "const": "passed" },
        "application_version": { "$ref": "#/$defs/version" },
        "revision": { "type": "integer", "minimum": 1 },
        "retention_days": { "type": "integer", "minimum": 1 }
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "final_revision",
        "final_retention_days",
        "backup_id",
        "backup_ciphertext_sha256",
        "backup_source_schema",
        "backup_target_schema",
        "uninstall_retention_verified",
        "direct_rollback_read_verified",
        "purged"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "final_revision": { "type": "integer", "minimum": 1 },
        "final_retention_days": { "type": "integer", "minimum": 1 },
        "backup_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backup_ciphertext_sha256": { "$ref": "#/$defs/sha256" },
        "backup_source_schema": { "type": "integer", "minimum": 1 },
        "backup_target_schema": { "type": "integer", "minimum": 1 },
        "uninstall_retention_verified": { "const": true },
        "direct_rollback_read_verified": { "const": true },
        "purged": { "const": true }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code"],
      "properties": {
        "stage": { "$ref": "#/$defs/phase/properties/name" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
      }
    }
  }
}
