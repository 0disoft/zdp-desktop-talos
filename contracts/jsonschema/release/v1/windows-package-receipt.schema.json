{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.0disoft.dev/talos/release/v1/windows-package-receipt.schema.json",
  "title": "Talos Windows Package Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "architecture",
    "source_commit",
    "signature_required",
    "release_probe_schema",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": "talos.windows-package-receipt/1" },
    "version": { "$ref": "#/$defs/version" },
    "architecture": { "const": "amd64" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "signature_required": { "type": "boolean" },
    "release_probe_schema": { "const": "talos.release-probe/1" },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        { "contains": { "properties": { "name": { "const": "talos-desktop.exe" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "talos-worker.exe" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "talosctl.exe" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "talos-release-probe.exe" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "pattern": "^talos-agent-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-windows-amd64-setup\\.exe$" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "signature_required": { "const": true } }, "required": ["signature_required"] },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/artifact" },
                {
                  "properties": {
                    "signature_status": { "const": "Valid" },
                    "signer_subject": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size", "signature_status", "signer_subject"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 160 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "signature_status": { "type": "string", "minLength": 1, "maxLength": 64 },
        "signer_subject": { "type": ["string", "null"], "maxLength": 1024 }
      }
    }
  }
}
